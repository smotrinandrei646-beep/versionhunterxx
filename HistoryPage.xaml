<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VersionHunterX.HistoryPage" Title="История поиска" BackgroundColor="{StaticResource Bg}">
  <ContentPage.ToolbarItems><ToolbarItem Text="Очистить" Clicked="OnClear" /></ContentPage.ToolbarItems>
  <CollectionView x:Name="List" Margin="16" SelectionMode="Single" SelectionChanged="OnSelected">
    <CollectionView.EmptyView><Label Text="История пуста." TextColor="{StaticResource Muted}" HorizontalTextAlignment="Center" Margin="20" /></CollectionView.EmptyView>
    <CollectionView.ItemTemplate>
      <DataTemplate>
        <Border Margin="0,5" Padding="16,12" BackgroundColor="{StaticResource Card}" Stroke="#3B2166" StrokeShape="RoundRectangle 14">
          <Label Text="{Binding .}" TextColor="White" FontSize="15" />
        </Border>
      </DataTemplate>
    </CollectionView.ItemTemplate>
  </CollectionView>
</ContentPage>
