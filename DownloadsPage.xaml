<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VersionHunterX.DownloadsPage" Title="Загрузки" BackgroundColor="{StaticResource Bg}">
  <CollectionView x:Name="List" Margin="16" SelectionMode="Single" SelectionChanged="OnSelected">
    <CollectionView.EmptyView><Label Text="Скачанных файлов пока нет." TextColor="{StaticResource Muted}" HorizontalTextAlignment="Center" Margin="20" /></CollectionView.EmptyView>
    <CollectionView.ItemTemplate>
      <DataTemplate>
        <Border Margin="0,6" Padding="16" BackgroundColor="{StaticResource Card}" Stroke="#3B2166" StrokeShape="RoundRectangle 18">
          <VerticalStackLayout Spacing="4">
            <Label Text="{Binding Name}" TextColor="White" FontSize="16" FontAttributes="Bold" />
            <Label Text="{Binding Subtitle}" TextColor="{StaticResource Accent}" FontSize="11" LineBreakMode="MiddleTruncation" />
            <Label Text="Нажмите: SHA-256 / установить / удалить" TextColor="{StaticResource Muted}" FontSize="11" />
          </VerticalStackLayout>
        </Border>
      </DataTemplate>
    </CollectionView.ItemTemplate>
  </CollectionView>
</ContentPage>
