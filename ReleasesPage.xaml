<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VersionHunterX.ReleasesPage" BackgroundColor="{StaticResource Bg}">
  <ContentPage.ToolbarItems>
    <ToolbarItem x:Name="FavItem" Clicked="OnFav" />
  </ContentPage.ToolbarItems>
  <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="16" RowSpacing="10">
    <VerticalStackLayout>
      <Label x:Name="Header" TextColor="White" FontSize="22" FontAttributes="Bold" />
      <Label x:Name="Sub" TextColor="{StaticResource Accent}" FontSize="13" />
    </VerticalStackLayout>
    <Button Grid.Row="1" Text="Открыть страницу проекта" Style="{StaticResource GradBtn}" Clicked="OnProject" />
    <VerticalStackLayout Grid.Row="2" Spacing="6">
      <ActivityIndicator x:Name="Busy" Color="#F472B6" />
      <ProgressBar x:Name="Prog" IsVisible="False" ProgressColor="#F472B6" />
      <Label x:Name="Status" TextColor="{StaticResource Muted}" FontSize="12" />
    </VerticalStackLayout>
    <CollectionView x:Name="List" Grid.Row="3" SelectionMode="None">
      <CollectionView.ItemTemplate>
        <DataTemplate>
          <Border Margin="0,6" Padding="14" BackgroundColor="{StaticResource Card}" Stroke="#3B2166" StrokeShape="RoundRectangle 18">
            <VerticalStackLayout Spacing="8">
              <Label Text="{Binding Title}" TextColor="White" FontSize="16" FontAttributes="Bold" />
              <Button Text="Страница релиза" Style="{StaticResource GradBtn}" HeightRequest="38" FontSize="12" Clicked="OnRelease" />
              <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Assets}">
                <BindableLayout.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                      <Label Text="{Binding Label}" TextColor="{StaticResource Muted}" FontSize="12" VerticalOptions="Center" LineBreakMode="MiddleTruncation" />
                      <Button Grid.Column="1" Text="⬇" Style="{StaticResource GradBtn}" WidthRequest="48" HeightRequest="40" Clicked="OnDownload" />
                      <Button Grid.Column="2" Text="🔗" BackgroundColor="#2A1850" TextColor="White" CornerRadius="14" WidthRequest="48" HeightRequest="40" Clicked="OnOpenLink" />
                    </Grid>
                  </DataTemplate>
                </BindableLayout.ItemTemplate>
              </VerticalStackLayout>
            </VerticalStackLayout>
          </Border>
        </DataTemplate>
      </CollectionView.ItemTemplate>
    </CollectionView>
  </Grid>
</ContentPage>
